## SYMMETRIC TREES
# CatBoost-style symmetric/oblivious trees for Sparse Oblique RF: K candidate
# projections shared across all nodes at depth d, one bag-wide sweep per
# candidate. Hooks into GrowTreeLocalBFS's depth-batch loop. Implies BFS.
# NOTE: does not include CatBoost's shared-entropy logic (1 entropy calc/depth).
# Runtime knob YDF_SYMMETRIC_MAX_DEPTH (default INT32_MAX = symmetric everywhere)
# caps the symmetric depth: levels deeper than it hand each frontier node off to
# the DFS grower (GrowTreeLocal). =0 is all-DFS. See SymmetricMaxDepth() in
# learner/decision_tree/training.cc; swept by benchmarks' dw1_depth_linesearch.sh
# --mode=symmetric.
# BFS_Only: isolates the cost/benefit of the BFS (level-order) scheduler vs DFS.
build:bfs_only --define=bfs_only=true

# NO_D2H: eliminate Device-to-Host and Host-to-Device transfers for
# selected_examples during BFS tree growth. Examples stay on GPU; splits
# use D2D copies and leaf values come from GPU class counts.
# Requires BFS_ONLY. Use --config=no_d2h alongside --config=bfs_only.
build --define=no_d2h=true
build:d2h --define=no_d2h=false

# D2D compaction strategy for SplitExamplesAllDepth (inside NO_D2H path).
build:d2d_direct --define=d2d=direct

# DEDUP_BOOTSTRAP: collapse duplicate bootstrap examples before projection,
# reducing work in the Apply Projection kernel. On by default.
build --define=dedup_bootstrap=true
build:no_dedup --define=dedup_bootstrap=false

# Projection kernel strategy for ColumnAddProjection.
# drsw: data-row-sorted-write (DRSW_1) — requires dedup_bootstrap (the default).
# default (no flag): SRDW_1_2D — 2D compacted grid, no wasted blocks.
build:drsw --define=use_drsw=true

# NODE_ID_DRSW: persistent node-ID-only approach. Maintains only d_node_ids[num_rows]
# across BFS depths; no d_selected_examples reordering, no d_node_offsets.
# Row-indexed projected layout: projected[proj_id * num_rows + row].
# Split update just rewrites node_ids and accumulates counts via atomics.
build:node_id_drsw --define=node_id_drsw=true

# NODE_ID_DRSW_SRDW_HIST: force NODE_ID_DRSW to use the SRDW histogram kernel
# (BuildHistogramRandomKernel_2D) instead of BuildHistogramDRSWKernel.
# Requires node_id_drsw.
build:nid_srdw_hist --define=nid_srdw_hist=true

# OFFSETS_ONLY: in NODE_ID_DRSW, run ComputeOffsetsOnly (derive d_node_offsets
# only) instead of the default ComputeOffsets (which also rebuilds the sorted
# d_selected_examples). Valid ONLY when every downstream consumer is node-id
# based (row-order ProjectionOnly + the default node-id histogram); incompatible
# with nid_srdw_hist, which reads d_selected_examples. Requires node_id_drsw.
build:offsets_only --define=offsets_only=true

# NODE_ID_DRSW_SRDW_LABEL_HIST: in NODE_ID_DRSW + offsets_only, build the histogram
# in SRDW order (block-per-node, shared-memory, coalesced) WITHOUT rebuilding
# d_selected_examples. The offsets scatter instead writes the per-example labels
# (and, under dedup_bootstrap, the per-example dup counts) directly into SRDW
# layout, so the histogram reads d_labels_srdw[row_start + r] coalesced rather
# than gathering d_labels[d_selected_examples[...]]. Requires node_id_drsw +
# offsets_only; incompatible with nid_srdw_hist. Intended use:
#   --config=node_id_drsw --config=offsets_only --config=scattered_label_hist
build:scattered_label_hist --define=scattered_label_hist=true

# SYMMETRIC_PROJ: make the sampled oblique projections symmetric across nodes
# per depth. All nodes at a given depth share the SAME set of num_proj
# projections (identical features + weights) instead of each node independently
# sampling its own. The per-node split threshold is still chosen from each
# node's own data, so only the projection directions are shared. Works with
# both the CPU sampler and --config=gpu_sample_proj (the GPU kernels seed curand
# by proj_id only instead of by the (node, proj) segment id).
build:symmetric_proj --define=symmetric_proj=true

# SPLIT_SMEM: NODE_ID_DRSW split-update accumulation of child counts + per-class
# counts. ON (default) = shared-memory block reduction (flush once per block);
# add --config=split_global_atomic to force per-row global atomicAdd. The smem
# path still auto-falls back to global atomic when the per-block shared-memory
# request exceeds the device cap (wide trees / many classes).
build --define=split_smem=true
build:split_global_atomic --define=split_smem=false

# VERBOSE_DEPTH: print per-depth timing breakdown to stderr.
# Off by default; add --config=verbose_depth to enable.
build:verbose_depth --define=verbose_depth=true

# GPU_SAMPLE_PROJ: move projection sampling (SampleProjection + FlattenProjections
# + H2D) to GPU.  Two cuRAND-based kernels + cub prefix sum produce the CSR
# directly on device, eliminating the CPU sample/flatten/remap/H2D per depth.
build --define=gpu_sample_proj=true
build:no_gpu_sample_proj --define=gpu_sample_proj=false

# USE_GPU: enable GPU code paths in the learner (BFS oblique projection,
# histogram splits, example partitioning). Without this, all tree growth
# uses the CPU-only NodeTrain path.
build:use_gpu --define=use_gpu=true

# Bazel configuration for Yggdrasil Decision Forests
#
# OPTIONS
#
# Linux
#
#   linux_cpp17: Linux build. Uses C++17.
#
# Linux options:
#
#   linux_avx2: AVX2.
#
# Windows
#
#  On Windows, uncomment the output_user_root option to avoid long path issues.
#
#   windows_cpp17: Windows build. Uses C++17.
#
# Windows options:
#
#   windows_avx2: AVX2.
#
# TensorFlow Defines:
#
#   use_tensorflow_io=1: Uses tensorflow for IO operations. Otherwise, use the
#     c++ Standard Library <filesystem>. Note: <filesystem> does not exist in
#     cpp<=14 and it had some issue with gcc<=8. Required to consume dataset
#     encoded as TFRecord of TF.Examples.
#   tensorflow_with_header_lib=1: Uses tensorflow header only library. Useful to
#     use tensorflow dynamic linking. Otherwise, links tensorflow statically (if
#     tensorflow is used).
#

# Common flags.
common --experimental_repo_remote_exec
common --enable_platform_specific_config

# Avoid long path issues on Windows
# startup --output_user_root=C:/tmpbld

# Flags to compile with or without recent version of Bazel.

# Required for bazel <=4, fails with bazel >= 5.
# common --incompatible_restrict_string_escapes=false

build -c opt --@rules_cuda//cuda:archs=sm_120
# build -c opt --@rules_cuda//cuda:archs=sm_89
build --announce_rc
build --noincompatible_strict_action_env

# Enable after adding python headers to protobuf.
# build --define=use_fast_cpp_protos=true
build --define=allow_oversize_protos=true
build --define=grpc_no_ares=true

# Nice print
build:linux --copt=-fdiagnostics-color=always
build --color=yes

# Disable dependencies to Tensorflow.
build --define=use_ydf_tensorflow_proto=1

# Suppress C++ compiler warnings.
build:linux --copt=-w
build:linux --host_copt=-w
build:macos --copt=-w
build:windows --copt=/W0
build:wasm --copt=-w
build:wasm --host_copt=-w

# Build mode.
build:linux --cxxopt=-std=c++17
build:linux --host_cxxopt=-std=c++17
build:linux_cpp17 --config=linux

build:macos --cxxopt=-std=c++17
build:macos --host_cxxopt=-std=c++17

build:windows_cpp17 --cxxopt=/std:c++17
build:windows_cpp17 --host_cxxopt=/std:c++17
build:windows_cpp17 --config=windows

build:windows_cpp20 --cxxopt=/std:c++20
build:windows_cpp20 --host_cxxopt=/std:c++20
build:windows_cpp20 --config=windows

# Instruction set optimizations
build:linux_avx2 --copt=-mavx2
build:windows_avx2 --copt=/arch:AVX2

# Misc build options we need for windows.
build:windows --copt=/D_USE_MATH_DEFINES
build:windows --host_copt=/D_USE_MATH_DEFINES
build:windows --copt=-DWIN32_LEAN_AND_MEAN
build:windows --host_copt=-DWIN32_LEAN_AND_MEAN
build:windows --copt=-DNOGDI
build:windows --host_copt=-DNOGDI
build:windows --linkopt=/NDEBUG
build:windows --host_linkopt=/NDEBUG
build:windows --linkopt=/OPT:REF
build:windows --host_linkopt=/OPT:REF
build:windows --linkopt=/OPT:ICF
build:windows --host_linkopt=/OPT:ICF
build:windows --experimental_strict_action_env=true
build:windows --copt=/Zc:preprocessor
build:windows --host_copt=/Zc:preprocessor
build:windows --materialize_param_files
build:windows --features=compiler_param_file
build:windows --verbose_failures
build:windows --copt=/Oi
build:windows --host_copt=/Oi
build:windows --copt=/GL
build:windows --host_copt=/GL

# Wasm
build:wasm --crosstool_top=@emsdk//emscripten_toolchain:everything
build:wasm --cpu=wasm
build:wasm --host_crosstool_top=@bazel_tools//tools/cpp:toolchain
build:wasm --copt="-Wno-deprecated-non-prototype"
build:wasm --copt="-Wno-unused-value"
build:wasm --copt="-Wno-unused-function"
build:wasm --copt="-Wno-deprecated-declarations"
build:wasm --copt="-Wno-unused-lambda-capture"
build:wasm --spawn_strategy=local
build:wasm --cxxopt=-std=c++17
build:wasm --host_cxxopt=-std=c++17
build:wasm --host_cxxopt="-fno-exceptions"

# Optional. Just to make it compatible with dynamic linking and TensorFlow.
# build --cxxopt="-D_GLIBCXX_USE_CXX11_ABI=0"
# build --host_cxxopt="-D_GLIBCXX_USE_CXX11_ABI=0"
